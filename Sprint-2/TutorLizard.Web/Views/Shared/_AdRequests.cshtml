@model AdRequestsListDto

<div class="card my-3">
    <div class="card-body">
        <h5 class="card-title">@Model.AdId</h5>
        <div class="row">
            <div class="col-6 col-sm-3">Ogłoszenie:</div>
            <div class="col-6 col-sm-9">@Model.AdId</div>
        </div>

        <div class="row">
            <div class="col-6 col-sm-3">Twoja wiadomość</div>
            <div class="col-6 col-sm-9">@Model.Message</div>
        </div>

        <div class="row">
            <div class="col-6 col-sm-3">Odpowiedź:</div>
            <div class="col-6 col-sm-9">@Model.ReplyMessage</div>
        </div>

        <div class="row">
            <div class="col-6 col-sm-3">Nauczanie zdalne:</div>
            <div class="col-6 col-sm-9">
                @if (Model.IsRemote)
                {
                    <span>Tak</span>
                }
                else
                {
                    <span>Nie</span>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-6 col-sm-3">Akceptacja:</div>
            <div class="col-6 col-sm-9">
                @if (Model.IsAccepted)
                {
                    <span>Nauczyciel zaakceptował Twoje zgłoszenie</span>
                }
                else
                {
                    <span>Nauczyciel nie zaakceptował Twojego zgłoszenia</span>
                }
            </div>
        </div>       


    </div>
</div>
