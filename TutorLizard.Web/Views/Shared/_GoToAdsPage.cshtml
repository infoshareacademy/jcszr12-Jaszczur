@model GoToAdsPageViewModel

<form asp-action="Page" asp-route-id="@Model.PageNumber" method="post">
    <input asp-for="SearchCriteria.SearchByText" type="hidden" />
    <input asp-for="SearchCriteria.SearchByPriceMin" type="hidden" />
    <input asp-for="SearchCriteria.SearchByPriceMax" type="hidden" />
    <input asp-for="SearchCriteria.SearchByLocation" type="hidden" />
    <input asp-for="SearchCriteria.SearchByCategoryId" type="hidden" />
    <input asp-for="SearchCriteria.SearchByIsRemote" type="hidden" />
    <input asp-for="SearchCriteria.Text" type="hidden" />
    <input asp-for="SearchCriteria.PriceMin" type="hidden" />
    <input asp-for="SearchCriteria.PriceMax" type="hidden" />
    <input asp-for="SearchCriteria.Location" type="hidden" />
    <input asp-for="SearchCriteria.CategoryId" type="hidden" />
    <input asp-for="SearchCriteria.IsRemote" type="hidden" />
    <button type="submit" class="btn btn-outline-primary btn-sm">@Model.Text</button>
</form>