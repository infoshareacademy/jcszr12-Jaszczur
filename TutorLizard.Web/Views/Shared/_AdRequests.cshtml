@model AdRequestsListDto


    <div class="card my-3 ad-list-item montserrat-lizardFont">
    <div class="card-body">
        <h5 class="card-title">@Model.AdId</h5>
        <div class="row">
            <div class="col-6 col-sm-3">Ogłoszenie:</div>
            <div class="col-6 col-sm-9">@Model.AdId</div>
        </div>

        <div class="row">
            <div class="col-6 col-sm-3">Twoja wiadomość</div>
            <div class="col-6 col-sm-9">@Model.Message</div>
        </div>

        <div class="row">
            <div class="col-6 col-sm-3">Odpowiedź:</div>
            <div class="col-6 col-sm-9">@Model.ReplyMessage</div>
        </div>

        <div class="row">
            <div class="col-6 col-sm-9">
                @if (Model.IsRemote)
                {
                    <span class="text-green">Zdalne</span>
                }
                else
                {
                    <span class="text-green">Stacjonarne</span>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-6 col-sm-9 margin-top-small">
                @if (Model.IsAccepted)
                {
                    <span class="text-green">Nauczyciel zaakceptował Twoje zgłoszenie</span>
                }
                else
                {
                    <span class="text-red">Nauczyciel nie zaakceptował Twojego zgłoszenia</span>
                }
            </div>
        </div>       


    </div>
</div>

