@model AdSearchCriteriaDto

<div>
    <div class="d-flex flex-row">
        <div class="align-content-center p-2">
            <input asp-for="SearchByText" class="form-check-input" />
        </div>
        <div class="form-group w-100 p-2 align-content-center">
            <label asp-for="Text" class="control-label"></label>
            <input asp-for="Text" class="form-control form-control-sm" />
        </div>
    </div>
    <div class="d-flex flex-row">
        <div class="align-content-center p-2">
            <input asp-for="SearchByPriceMin" class="form-check-input" />
        </div>
        <div class="form-group w-100 p-2 align-content-center">
            <label asp-for="PriceMin" class="control-label"></label>
            <input asp-for="PriceMin" class="form-control form-control-sm" />
        </div>

        <div class="align-content-center p-2">
            <input asp-for="SearchByPriceMax" class="form-check-input" />
        </div>
        <div class="form-group w-100 p-2 align-content-center">
            <label asp-for="PriceMax" class="control-label"></label>
            <input asp-for="PriceMax" class="form-control form-control-sm" />
        </div>
    </div>
    <div class="d-flex flex-row">
        <div class="align-content-center p-2">
            <input asp-for="SearchByLocation" class="form-check-input" />
        </div>
        <div class="form-group w-100 p-2 align-content-center">
            <label asp-for="Location" class="control-label"></label>
            <input asp-for="Location" class="form-control form-control-sm" />
        </div>
    </div>
    <div class="d-flex flex-row">
        <div class="align-content-center p-2">
            <input asp-for="SearchByCategoryId" class="form-check-input" />
        </div>
        <div class="form-group w-100 p-2 align-content-center">
            <label asp-for="CategoryId" class="control-label"></label>
            @if (ViewBag.Categories is not null)
            {
                <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-select"></select>
            }
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="align-content-center p-2">
            <input asp-for="SearchByIsRemote" class="form-check-input" />
        </div>
        <div class="form-group w-100 p-2 align-content-center">
            <input asp-for="IsRemote" class="form-check-input" />
            <label asp-for="IsRemote" class="control-label"></label>
        </div>
    </div>
</div>