@using TutorLizard.Web﻿
@using System.Security.Claims
@{
    var claims = (User.Identity as ClaimsIdentity)?.Claims;

    string? role = claims?.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
    string? userName = claims?.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tutor Lizard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tutorlizard.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TutorLizard.Web.styles.css" asp-append-version="true" />
    <base href="~/" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-white.png" alt="Logo" class="logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse d-sm-inline-flex justify-content-between collapse">
                    <ul class="navbar-nav flex-grow-1">
                        <div class="nav-item dropdown">
                            <a class="nav-link dropbtn">Funkcje<i class="fa fa-caret-down"></i></a>
                            <div class="dropdown-content">
                                <a asp-controller="Tutor" asp-action="Index">Nauczyciel</a>
                                <a asp-controller="Student" asp-action="Index">Uczeń</a>
                                <a asp-controller="Browse" asp-action="Schedule">Kalendarz</a>
                            </div>
                        </div>

                        <div class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Browse" asp-action="Ads">Przeglądaj</a>
                        </div>
                        <ul class="navbar-nav ms-auto">
                            <div class="btn-group">


                        <div class="nav-item dropdown">
                                <a class="nav-link dropbtn">
                                    @if (Thread.CurrentThread.CurrentCulture.ToString() == "pl")
                                    {
                                        <span>Polski</span>
                                    }
                                    else
                                    {
                                        <span>English</span>
                                    }<i class="fa fa-caret-down"></i>
                                </a>
                            <div class="dropdown-content">
                                    <a asp-controller="Home" asp-action="ChangeLanguage" asp-route-language="pl" asp-route-returnUrl="@Context.Request.Path">Polski</a>
                                    <a asp-controller="Home" asp-action="ChangeLanguage" asp-route-language="en" asp-route-returnUrl="@Context.Request.Path">English</a>
                            </div>
                        </div>


                        @if (userName is null)
                        {
                            <div class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">@TutorLizard.Web.Resources.Shared.RegisterMenu</a>
                            </div>
                            <div class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">@TutorLizard.Web.Resources.Shared.LoginMenu</a>
                            </div>
                        }
                        else
                        {
                            <div class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Logout">@TutorLizard.Web.Resources.Shared.LogoutMenu</a>
                            </div>
                            
                            <div class="nav-item">
                                <span class="nav-link">@userName</span>
                            </div>

                            @* <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Data">@TutorLizard.Web.Resources.Shared.AdminPanelMenu</a>
                            </li> *@
                        }
                        </ul>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <partial name="@PartialNames.UiMessages" />
        <main role="main" class="pb-3 main-margin">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - TutorLizard.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/_framework/blazor.web.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>

