@using TutorLizard.Web﻿
@using System.Security.Claims
@{
    var claims = (User.Identity as ClaimsIdentity)?.Claims;

    string? role = claims?.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
    string? userName = claims?.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TutorLizard.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TutorLizard.Web.styles.css" asp-append-version="true" />
    <base href="~/" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TutorLizard.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse d-sm-inline-flex justify-content-between collapse">
                    <ul class="navbar-nav flex-grow-1">
                        <div class="btn-group">
                            <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (Thread.CurrentThread.CurrentCulture.ToString() == "pl")
                                {
                                    <span>Polski</span>
                                }
                                else
                                {
                                    <span>English</span>
                                }
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Home"
                                       asp-action="ChangeLanguage"
                                       asp-route-language="pl"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       asp-route-queryString="@Context.Request.QueryString">
                                       Polski
                                   </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Home"
                                       asp-action="ChangeLanguage"
                                       asp-route-language="en"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       asp-route-queryString="@Context.Request.QueryString">
                                       English
                                   </a>
                                </li>
                            </ul>
                        </div>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">@TutorLizard.Web.Resources.Shared.HomeMenu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Browse" asp-action="Ads">@TutorLizard.Web.Resources.Shared.Browse</a>
                        </li>   
                        @if (userName is null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">@TutorLizard.Web.Resources.Shared.RegisterMenu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">@TutorLizard.Web.Resources.Shared.LoginMenu</a>
                            </li>
                        } else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">@TutorLizard.Web.Resources.Shared.LogoutMenu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Data">@TutorLizard.Web.Resources.Shared.AdminPanelMenu</a>
                            </li>
                            <li>
                                <span class="nav-link text-dark">@userName</span>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <partial name="@PartialNames.UiMessages" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - TutorLizard.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/_framework/blazor.web.js"></script>
    <script>
        window.blazorCulture = {
            get: () => {
                const language = document.cookie.split(';').map(v => v.trim().split('=')).find(pair => pair[0] === 'Language')[1]
                return language;
            },
        };
    </script>
</body>
</html>
