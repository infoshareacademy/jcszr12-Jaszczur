@model AdRequestsListDto

<div class="card my-3 ad-list-item">

    <div class="card-body">
        <h5 class="card-title">@Model.AdSubject</h5>
        <div class="row">
            <div class="col-6 col-sm-3">Temat:</div>
            <div class="col-6 col-sm-9">@Model.AdTitle</div>
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">Wiadomoœæ od ucznia:</div>
            <div class="col-6 col-sm-9">@Model.Message</div>
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">Wiadomoœæ zwrotna:</div>
            <div class="col-6 col-sm-9">@Model.ReplyMessage</div>
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">Data przegl¹du:</div>
            @if (Model.ReviewDate is not null)
            {
                <div class="col-6 col-sm-9">@Model.ReviewDate</div>
            }
            else {
                <div class="col-6 col-sm-9">Nowy!</div>
            }
        </div>
        <div class="row">
                <div class="col-6 col-sm-9">
                    @if (Model.IsRemote)
                {
                    <span class="text-green">Zdalne</span>
                }
                else
                {
                    <span class="text-green">Stacjonarne</span>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">Status:</div>
            <div class="col-6 col-sm-9">
                @if (Model.IsAccepted)
                {
                    <span class="text-green">Zaakceptowane</span>
                }
                else
                {
                    <span class="text-red">Niezaakceptowane</span>
                }
            </div>
        </div>
    </div>
</div>
