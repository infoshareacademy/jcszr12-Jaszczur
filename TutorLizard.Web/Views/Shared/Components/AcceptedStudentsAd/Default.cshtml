@using TutorLizard.BusinessLogic.Data.Repositories.Json
@using TutorLizard.BusinessLogic.Interfaces.Services
@using TutorLizard.Web.ViewComponents
@model AvailableScheduleForAdRequest

@inject AcceptedStudentsAdViewComponent ViewComponent
@inject IUserAuthenticationService _userAuthenticationService
@inject AdRequestDto _adRequestDto


<div class="modal-body">
    @* Check if the current user is logged in and accepted *@
    @if (_userAuthenticationService.GetLoggedInUserId())
    {
        @* Pass an AdDetailsRequest object to the View Component *@
        @await ViewComponent.InvokeAsync("AcceptedStudentsAd", new { request = new AdDetailsRequest() { IsAccepted = true } })
    }
    else
    {
        <p>You are not logged in or haven't been accepted yet.</p>
    }
</div>

