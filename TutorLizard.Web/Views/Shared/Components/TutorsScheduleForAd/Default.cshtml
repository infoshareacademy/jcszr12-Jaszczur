@model GetTutorsScheduleForAdResponse?

@if(Model is not null)
{
    <div>
        <div class="row">
                <h3 class ="title-2 col-sm-12 col-md-6">Terminy</h3>
            <div class="mx-autolist-group col-sm-12 col-md-6 margin-top-small"><a href="@Url.Action("CreateScheduleItem", "Tutor", new { id = Model.AdId })" class="btn btn-details">@TutorLizard.Web.Resources.Shared.AddScheduleItem</a></div>
        </div>
        @foreach(var scheduleItem in Model.ScheduleItems)
        {
            <div class="border-1 ad-list-item my-3">
                <div class="title-2 mx-auto"><h4>@scheduleItem.DateTime</h4></div>
                <div class="row align-items-center col-lg-10 mx-auto">
                    @if(scheduleItem.Requests.Count == 0)
                    {
                        <div class="text-red"><h5>@TutorLizard.Web.Resources.Shared.NoRequests</h5></div>
                    }
                    else
                    {
                        <div class="text-green"><h5>Zgłoszenia:</h5></div>
                        @foreach (var request in scheduleItem.Requests)
                        {
                            <div class="border-1 user-container">
                                <div><h6>@request.StudentName</h6></div>
                                <div>@TutorLizard.Web.Resources.Shared.RequestDate : @request.DateCreated</div>
                                <div>
                                    <span>@TutorLizard.Web.Resources.Shared.IsRemote : </span>
                                    @if (request.IsRemote)
                                    {
                                        <span>@TutorLizard.Web.Resources.Shared.Yes</span>
                                    }
                                    else
                                    {
                                        <span>@TutorLizard.Web.Resources.Shared.No</span>
                                    }
                                </div>
                                <div class="d-flex flex-column">
                                    @if (request.IsAccepted)
                                    {
                                        <span>@TutorLizard.Web.Resources.Shared.RequestIsAccepted</span>
                                        <form asp-controller="Tutor" asp-action="UnacceptScheduleItemRequest" method="post" >
                                            <input name="adId" value="@Model.AdId" type="hidden"/>
                                            <input name="scheduleItemRequestId" value="@request.Id" type="hidden"/>
                                            <button class="btn btn-danger mt-3">@TutorLizard.Web.Resources.Shared.CancelAcceptation</button>
                                        </form>
                                    }
                                    else if (request.CanBeAccepted)
                                    {
                                        <span>@TutorLizard.Web.Resources.Shared.RequestIsRejected</span>
                                        <form asp-controller="Tutor" asp-action="AcceptScheduleItemRequest" method="post">
                                            <input name="adId" value="@Model.AdId" type="hidden"/>
                                            <input name="scheduleItemRequestId" value="@request.Id" type="hidden" />
                                            <button class="btn btn-success mt-3">@TutorLizard.Web.Resources.Shared.Accept</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>@TutorLizard.Web.Resources.Shared.RequestCannotBeAccepted</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}