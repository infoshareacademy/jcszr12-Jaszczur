@model GetTutorsScheduleForAdResponse?

@if(Model is not null)
{
    <div>
        <div class="title"><h3>Terminy</h3></div>
        <div>
            <ul class="list-group col-md-6 col-xl-12">
                <li class="list-group-item"><a href="@Url.Action("CreateScheduleItem", "Tutor", new { id = Model.AdId })" class="btn btn-success">Dodaj termin</a></li>
            </ul>
        </div>
        @foreach(var scheduleItem in Model.ScheduleItems)
        {
            <div class="my-3 p-3 border border-2">
                <div><h4>@scheduleItem.DateTime</h4></div>
                <div class="row">
                    @if(scheduleItem.Requests.Count == 0)
                    {
                        <h5>Brak zgłoszeń</h5>
                    }
                    else
                    {
                        <h5>Zgłoszenia:</h5>
                        @foreach (var request in scheduleItem.Requests)
                        {
                            <div class="col-sm-3 border-1 p-3 m-2 border">
                                <div><h6>@request.StudentName</h6></div>
                                <div>Zgłoszenie wysłane: @request.DateCreated</div>
                                <div>
                                    <span>Nauczanie zdalne: </span>
                                    @if (request.IsRemote)
                                    {
                                        <span>Tak</span>
                                    }
                                    else
                                    {
                                        <span>Nie</span>
                                    }
                                </div>
                                <div class="d-flex flex-column">
                                    @if (request.IsAccepted)
                                    {
                                        <span>Zgłoszenie zaakceptowane</span>
                                        <form asp-controller="Tutor" asp-action="UnacceptScheduleItemRequest" method="post" >
                                            <input name="adId" value="@Model.AdId" type="hidden"/>
                                            <input name="scheduleItemRequestId" value="@request.Id" type="hidden"/>
                                            <button class="btn btn-danger mt-3">Anuluj akceptację</button>
                                        </form>
                                    }
                                    else if (request.CanBeAccepted)
                                    {
                                        <span>Zgłoszenie niezaakceptowane</span>
                                        <form asp-controller="Tutor" asp-action="AcceptScheduleItemRequest" method="post">
                                            <input name="adId" value="@Model.AdId" type="hidden"/>
                                            <input name="scheduleItemRequestId" value="@request.Id" type="hidden" />
                                            <button class="btn btn-success mt-3">Zaakceptuj</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>Zgłoszenie nie może zostać zaakceptowane</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}