@model CreateAdRequestRequest

@if(Model is not null)
{
    <div class="row">
        <div class="col-md-4">
                <form asp-controller="Student" asp-action="CreateAdRequest">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="AdId" />
                <div><h3>@TutorLizard.Web.Resources.Shared.SignUp</h3></div>
                    <div class="form-group">
                        <label asp-for="Message" class="control-label"></label>
                        <textarea asp-for="Message" class="form-control"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check my-2">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="IsRemote" /> @Html.DisplayNameFor(model => model.IsRemote)
                        </label>
                    </div>
                    <div>
                    <input type="submit" value="@TutorLizard.Web.Resources.Shared.SendRequest" class="btn btn-primary w-100" />
                    </div>
                </form>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}