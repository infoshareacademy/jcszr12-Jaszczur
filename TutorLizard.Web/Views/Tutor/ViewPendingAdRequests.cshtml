@model TutorsPendingAdRequestsResponse

@{
    ViewData["Title"] = "ViewPendingAdRequests";
}

<h1>PendingAdRequests</h1>
@foreach (var adrequest in Model.AdRequests)
{
    @if (adrequest.IsAccepted == false && adrequest.ReviewDate is null)
    {
        <partial name="_PendingAdRequestsListItem" model="adrequest" />
    }
}
