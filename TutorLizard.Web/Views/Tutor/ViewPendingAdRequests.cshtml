@using TutorLizard.Web.Resources
@model GetTutorsPendingAdRequestsResponse

@{
    ViewData["Title"] = "ViewPendingAdRequests";
}

<h1 class="title">@TutorLizard.Web.Resources.Tutor.AllPendingRequests</h1>
<div class="row">
@foreach (var adrequest in Model.AdRequests)
{
        <div class="col-12 col-md-6 flex-row flex-column">
            <partial name="@PartialNames.PendingAdRequestsListItem" model="adrequest" />
            </div>
    }
</div>
