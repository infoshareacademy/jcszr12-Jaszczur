@model CreateScheduleItemRequest

@{
    ViewData["Title"] = "Dodaj termin";
}

<h1 class="title">Nowy termin</h1>

<hr />
<div class="row ad-list-item mx-auto">
    <div class="col-md-4 mx-auto">
        <form asp-action="CreateScheduleItem">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="AdId" class="form-control" type="hidden"/>
            <div class="form-group">
                <label asp-for="DateTime" class="control-label"></label>
                <input asp-for="DateTime" class="form-control" />
                <span asp-validation-for="DateTime" class="text-danger"></span>
            </div>
            <button type="submit" class="btn w-100 btn-outline-dark">Zatwierdź</button>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
