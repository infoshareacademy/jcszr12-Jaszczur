@model TutorLizard.Web.Models.LoginModel

@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<h4>LoginModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UserName" class="control-label"></label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group my-2">
                <input type="submit" value="Login" class="btn btn-primary" />
            </div>
        </form>
        <div class="row pt-2">
            <div class="col-md-4">
                <h5>External Login</h5>

                @if(Model.AuthenticationSchemes.Count() == 0)
                {
                    <div>No external login provides available</div>
                } else
                {
                    <form asp-action="ExternalLogin">
                        <div>
                            @foreach(var provider in Model.AuthenticationSchemes)
                            {
                                <button type="submit" 
                                    class="btn btn-primary" 
                                    name="provider" 
                                    value="@provider.Name" 
                                    title="Login using your @provider.Name">
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index" asp-controller="Home">Back</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}