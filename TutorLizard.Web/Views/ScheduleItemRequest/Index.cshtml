@model IEnumerable<TutorLizard.BusinessLogic.Models.ScheduleItemRequest>

@{
    ViewData["Title"] = "Schedule Item Requests";
}

<h1>@TutorLizard.Web.Resources.ScheduleItemRequest.ScheduleItemRequests</h1>

<p>
    <a asp-action="Create">@TutorLizard.Web.Resources.ScheduleItemRequest.CreateNew</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @TutorLizard.Web.Resources.ScheduleItemRequest.ScheduleItemId
            </th>
            <th>
                @TutorLizard.Web.Resources.ScheduleItemRequest.StudentId
            </th>
            <th>
                @TutorLizard.Web.Resources.ScheduleItemRequest.IsAccepted
            </th>
            <th>
                @TutorLizard.Web.Resources.ScheduleItemRequest.IsRemote
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ScheduleItemId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StudentId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsAccepted)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsRemote)
            </td>
            <td>
                    @Html.ActionLink(@TutorLizard.Web.Resources.ScheduleItemRequest.Edit, "Edit", new { id = item.Id }) |
                    @Html.ActionLink(@TutorLizard.Web.Resources.ScheduleItemRequest.Details, "Details", new { id = item.Id }) |
                    @Html.ActionLink(@TutorLizard.Web.Resources.ScheduleItemRequest.Delete, "Delete", new { id = item.Id })
            </td>
        </tr>
}
    </tbody>
</table>
