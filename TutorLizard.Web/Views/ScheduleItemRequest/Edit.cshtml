@model TutorLizard.BusinessLogic.Models.ScheduleItemRequest

@{
    ViewData["Title"] = "Edit";
}

<h1>@TutorLizard.Web.Resources.ScheduleItemRequest.Edit</h1>

<h4>@TutorLizard.Web.Resources.ScheduleItemRequest.ScheduleItemRequests</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ScheduleItemId" class="control-label">@TutorLizard.Web.Resources.ScheduleItemRequest.ScheduleItemId</label>
                <input asp-for="ScheduleItemId" class="form-control" placeholder="@TutorLizard.Web.Resources.ScheduleItemRequest.ScheduleItemId" />
                <span asp-validation-for="ScheduleItemId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudentId" class="control-label">@TutorLizard.Web.Resources.ScheduleItemRequest.StudentId</label>
                <input asp-for="StudentId" class="form-control" placeholder="@TutorLizard.Web.Resources.ScheduleItemRequest.StudentId" />
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsAccepted" /> @TutorLizard.Web.Resources.ScheduleItemRequest.IsAccepted
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsRemote" /> @TutorLizard.Web.Resources.ScheduleItemRequest.IsRemote
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="@TutorLizard.Web.Resources.ScheduleItemRequest.Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@TutorLizard.Web.Resources.ScheduleItemRequest.BackToList</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
