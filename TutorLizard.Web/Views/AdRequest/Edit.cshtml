@using TutorLizard.Web.Resources
@model TutorLizard.BusinessLogic.Models.AdRequest

@{
    ViewData["Title"] = "Edit";
}

<h1>@TutorLizard.Web.Resources.AdRequest.Edit</h1>

<h4>@TutorLizard.Web.Resources.AdRequest.AdRequests</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="AdId" class="control-label">@TutorLizard.Web.Resources.AdRequest.AdId</label>
                <input asp-for="AdId" class="form-control" placeholder="@TutorLizard.Web.Resources.AdRequest.AdId" />
                <span asp-validation-for="AdId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudentId" class="control-label">@TutorLizard.Web.Resources.AdRequest.StudentId</label>
                <input asp-for="StudentId" class="form-control" placeholder="@TutorLizard.Web.Resources.AdRequest.StudentId" />
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsAccepted" /> @TutorLizard.Web.Resources.AdRequest.Status
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Message" class="control-label">@TutorLizard.Web.Resources.AdRequest.Message</label>
                <input asp-for="Message" class="form-control" placeholder="@TutorLizard.Web.Resources.AdRequest.Message" />
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReplyMessage" class="control-label">@TutorLizard.Web.Resources.AdRequest.ReplyMessage</label>
                <input asp-for="ReplyMessage" class="form-control" placeholder="@TutorLizard.Web.Resources.AdRequest.ReplyMessage" />
                <span asp-validation-for="ReplyMessage" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsRemote" /> @TutorLizard.Web.Resources.AdRequest.IsRemote
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="@TutorLizard.Web.Resources.AdRequest.Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@TutorLizard.Web.Resources.AdRequest.BackToList</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
