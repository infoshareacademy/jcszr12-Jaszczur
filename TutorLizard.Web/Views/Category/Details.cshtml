@using TutorLizard.Web.Resources
@model TutorLizard.BusinessLogic.Models.Category

@{
    ViewData["Title"] = "Details";
}

<h1>@TutorLizard.Web.Resources.Category.Details</h1>

<div>
    <h4>@TutorLizard.Web.Resources.Category.Category</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class = "col-sm-2">
            @TutorLizard.Web.Resources.Category.Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @TutorLizard.Web.Resources.Category.Description
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>
</div>
<div>
    @Html.ActionLink(@TutorLizard.Web.Resources.Category.Edit, "Edit", new { id = Model.Id }) |
    <a asp-action="Index">Back to List</a>
</div>
