@using TutorLizard.Web.Resources
@model TutorLizard.BusinessLogic.Models.User

@{
    ViewData["Title"] = "Delete";
}

<h1>@TutorLizard.Web.Resources.User.Delete</h1>

<h3>@TutorLizard.Web.Resources.User.SureToDelete</h3>
<div>
    <h4>User</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class = "col-sm-2">
            @TutorLizard.Web.Resources.User.Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @TutorLizard.Web.Resources.User.UserType
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserType)
        </dd>
        <dt class = "col-sm-2">
            @TutorLizard.Web.Resources.User.Email
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @TutorLizard.Web.Resources.User.Password
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PasswordHash)
        </dd>
        <dt class = "col-sm-2">
            @TutorLizard.Web.Resources.User.DateCreated
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateCreated)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="submit" value="@TutorLizard.Web.Resources.User.Delete" class="btn btn-danger" /> |
        <a asp-action="Index">@TutorLizard.Web.Resources.User.BackToList</a>
    </form>
</div>
