@model GetBrowseAdsPageResponse

@{
    ViewData["Title"] = "Ogłoszenia";
}

<h1>Ogłoszenia</h1>

<form asp-action="Search" method="post" class="d-flex flex-column p-2 border">
    <h2 class="text-center">Wyszukiwanie ogłoszeń</h2>
    <partial name="@PartialNames.AdSearchCriteria" model="Model.SearchCriteria"/>
    <button type="submit" class="btn btn-primary m-2">Wyszukaj</button>
</form>
@foreach (var ad in Model.Ads)
{
    <partial name="@PartialNames.AdListItem" model="ad" />
}

<div class="row text-center">

    <div class="col-4">
        @if(Model.PageNumber > 1)
        {
            <partial name="@PartialNames.GoToAdsPage"
                     model="@(new GoToAdsPageViewModel(Model.PageNumber -1, "Poprzednia strona", Model.SearchCriteria))" />
        }
    </div>

    <div class="col-4">
        Strona @Model.PageNumber z @Model.TotalPages
    </div>

    <div class="col-4">
        @if(Model.TotalPages > Model.PageNumber)
        {
            <partial name="@PartialNames.GoToAdsPage"
                     model="@(new GoToAdsPageViewModel(Model.PageNumber +1, "Następna strona", Model.SearchCriteria))" />
        }
    </div>

</div>