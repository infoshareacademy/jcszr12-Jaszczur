@using TutorLizard.Web.Extensions
@using TutorLizard.Blazor.Extensions
@model GetBrowseAdsPageResponse

@{
    ViewData["Title"] = "Ogłoszenia";
    List<CategoryDto> categories = [];
    if (ViewBag.Categories is not null)
    {
        categories = ViewBag.Categories;
    }
}

<h1>@TutorLizard.Web.Resources.Browse.Ads</h1>

<form asp-action="Search" method="post" class="d-flex flex-column p-2 border">
    <h2 class="text-center">@TutorLizard.Web.Resources.Browse.BrowsingAds</h2>
    <component type="typeof(AdSearchForm)"
               render-mode="WebAssemblyPrerendered"
               param-SearchCriteriaJson="Model.SearchCriteria.ToViewModel().Serialize()"
               param-CategoriesJson="@categories.Serialize()" />
    <button type="submit" class="btn btn-primary m-2">@TutorLizard.Web.Resources.Browse.Search</button>
</form>



@if (Model.SearchCriteria.AnySearch)
{
    <div class="p-2">@TutorLizard.Web.Resources.Browse.NumberOfResults : @Model.TotalAds</div>
}

@foreach (var ad in Model.Ads)
{
    <partial name="@PartialNames.AdListItem" model="ad" />
}

<div class="row text-center">

    <div class="col-4">

        @if(Model.PageNumber > 1)
        {
            @if (Model.SearchCriteria.AnySearch)
            {
                <a asp-action="Ads" asp-route-id="@(Model.PageNumber - 1)" asp-route-search="@Model.SearchCriteria.ToBase64String()">@TutorLizard.Web.Resources.Browse.PreviousPage</a>
            }
            else
            {
                <a asp-action="Ads" asp-route-id="@(Model.PageNumber - 1)">@TutorLizard.Web.Resources.Browse.PreviousPage</a>
            }
        }
    </div>

    <div class="col-4">
        @TutorLizard.Web.Resources.Browse.Page @Model.PageNumber z @Model.TotalPages
    </div>

    <div class="col-4">
        @if(Model.TotalPages > Model.PageNumber)
        {
            @if(Model.SearchCriteria.AnySearch)
            {
                <a asp-action="Ads" asp-route-id="@(Model.PageNumber + 1)" asp-route-search="@Model.SearchCriteria.ToBase64String()">@TutorLizard.Web.Resources.Browse.NextPage</a>
            }
            else
            {
                <a asp-action="Ads" asp-route-id="@(Model.PageNumber + 1)">@TutorLizard.Web.Resources.Browse.NextPage</a>
            }
        }
    </div>

</div>