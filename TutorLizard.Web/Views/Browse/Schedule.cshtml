@model GetUsersScheduleResponse

<h1>@TutorLizard.Web.Resources.Browse.YourSchedule</h1>

<div class="row">
    <div class="col-sm-6 d-flex flex-column">
        <h2>@TutorLizard.Web.Resources.Browse.AsStudent</h2>
        @if(Model.StudentsSchedule.Count == 0)
        {
            <div>
                @TutorLizard.Web.Resources.Browse.NoClassDates
            </div>
        }
        else
        {
            foreach(var item in Model.StudentsSchedule)
            {
                <div class="p-3 my-2 border border-2">
                    <div><a asp-action="AdDetails" asp-route-id="@item.AdId">@item.AdTitle</a></div>
                    <div class="h3">@item.DateTime</div>
                    <div>@TutorLizard.Web.Resources.Browse.Tutor : @item.TutorName</div>
                    <div>
                        <span>@TutorLizard.Web.Resources.Browse.ScheduleItemStatus: </span>
                        @if (item.Status == StudentsScheduleItemSummaryDto.RequestStatus.Accepted)
                        {
                            <span>@TutorLizard.Web.Resources.Browse.Accepted</span>
                        }
                        else if (item.Status == StudentsScheduleItemSummaryDto.RequestStatus.Pending)
                        {
                            <span>@TutorLizard.Web.Resources.Browse.Pending</span>
                        }
                        else if (item.Status == StudentsScheduleItemSummaryDto.RequestStatus.Rejected)
                        {
                            <span>@TutorLizard.Web.Resources.Browse.Rejected</span>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-sm-6 d-flex flex-column">
        <h2>@TutorLizard.Web.Resources.Browse.AsTutor</h2>
        @if (Model.TutorsSchedule.Count == 0)
        {
            <div>
                @TutorLizard.Web.Resources.Browse.NoClassDates
            </div>
        }
        else
        {
            foreach (var item in Model.TutorsSchedule)
            {
                <div class="p-3 my-2 border border-2">
                    <div><a asp-action="AdDetails" asp-route-id="@item.AdId">@item.AdTitle</a></div>
                    <div class="h3">@item.DateTime</div>
                    <div>@TutorLizard.Web.Resources.Browse.RequestCount : @item.RequestCount</div>
                    <div>
                        <span>@TutorLizard.Web.Resources.Browse.AcceptedStudentName : </span>
                        @if (item.AcceptedStudentsName is null)
                        {
                            <span>@TutorLizard.Web.Resources.Browse.None</span>
                        }
                        else
                        {
                            <span>@item.AcceptedStudentsName</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>