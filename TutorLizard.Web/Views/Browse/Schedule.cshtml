@using TutorLizard.Web.Extensions
@model GetUsersScheduleResponse

<h1>Twoje terminy</h1>

<div class="row">
    <component type="typeof(Schedule)"
               render-mode="WebAssemblyPrerendered"
               param-Year="Model.Year"
               param-Month="Model.Month"
               param-TutorsSchedule="@Model.TutorsSchedule.Serialize()"
               param-StudentsSchedule="@Model.StudentsSchedule.Serialize()"/>
</div>
