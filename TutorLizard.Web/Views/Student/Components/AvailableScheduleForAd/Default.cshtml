@using static TutorLizard.BusinessLogic.Models.DTOs.ScheduleItemDto
@model AvailableScheduleForAdResponse?

@if (Model is not null)
{
    <h1>Szczegóły ogłoszenia</h1>
    <div>
        @if (Model.IsAccepted == true)
        {
            <ul>
                @foreach (var item in Model.Items)
                {
                    <li>@item.DateTime</li>

                    @if (item.Status == ScheduleItemRequestStatus.Accepted)
                    {
                        <span>Zaakceptowane</span>
                    }
                    else if (item.Status == ScheduleItemRequestStatus.Pending)
                    {
                        <span>Oczekujące</span>
                    }
                    else if (item.Status == ScheduleItemRequestStatus.Rejected)
                    {
                        <span>Odrzucone</span>
                    }
                    else
                    {
                        <a href="/Browse/Ads"><button>Zapisz się</button></a>
                    }
                }
            </ul>
        }

        <h3>Testowe dane</h3>
        <div>
            <ul>
                <li>Termin: 10 maja 2024, godzina 15:00, online</li>
                <a href="/Browse/Ads"><button>Zapisz się</button></a>
            </ul>
        </div>
    </div>
}






