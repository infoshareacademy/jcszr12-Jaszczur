@model GetStudentsAdRequestsResponse
@{
    ViewData["Title"] = "AdRequests";
}
    
<h1 class="title">Oczekujące zgłoszenia</h1>
<div class="row">
@foreach(var adRequest in Model.AdRequests)
{
        <div class="col-12 col-md-6 flex-row flex-column">
            <partial name="@PartialNames.AdRequest" model="adRequest" />
        </div>
    }
</div>
