@model GetStudentsAcceptedAdsResponse
@{
    ViewData["Title"] = "AcceptedAds";
}

<h1 class="title">Zatwierdzone zgłoszenia</h1>
<div class="row">
@foreach(var ad in Model.Ads)
{
        <div class="col-12 col-md-6 flex-row flex-column my-3">
            <partial name="@PartialNames.AdListItem" model="ad" />
            </div>
    }
</div>

