@using TutorLizard.Web.Resources
@model TutorLizard.BusinessLogic.Models.Ad

@{
    ViewData["Title"] = "Edit";
}

<h1>@TutorLizard.Web.Resources.Ad.Edit</h1>

<h4>@TutorLizard.Web.Resources.Ad.Advertisement</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TutorId" class="control-label">@TutorLizard.Web.Resources.Ad.TutorId</label>
                <input asp-for="TutorId" class="form-control" placeholder="@TutorLizard.Web.Resources.Ad.TutorId" />
                <span asp-validation-for="TutorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Subject" class="control-label">@TutorLizard.Web.Resources.Ad.Subject</label>
                <input asp-for="Subject" class="form-control" placeholder="@TutorLizard.Web.Resources.Ad.Subject" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title" class="control-label">@TutorLizard.Web.Resources.Ad.Title</label>
                <input asp-for="Title" class="form-control" placeholder="@TutorLizard.Web.Resources.Ad.Title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">@TutorLizard.Web.Resources.Ad.Description</label>
                <input asp-for="Description" class="form-control" placeholder="@TutorLizard.Web.Resources.Ad.Description" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">@TutorLizard.Web.Resources.Ad.CategoryId</label>
                @if (ViewBag.Categories is not null)
                {
                    <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-select"></select>
                }
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label">@TutorLizard.Web.Resources.Ad.Price</label>
                <input asp-for="Price" class="form-control" type="number" placeholder="@TutorLizard.Web.Resources.Ad.Price" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Location" class="control-label">@TutorLizard.Web.Resources.Ad.Location</label>
                <input asp-for="Location" class="form-control" placeholder="@TutorLizard.Web.Resources.Ad.Location" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsRemote" /> @TutorLizard.Web.Resources.Ad.IsRemote
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="@TutorLizard.Web.Resources.Ad.Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
