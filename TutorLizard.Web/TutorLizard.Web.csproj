      <LastGenOutput>AdRequest.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Browse.en.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Browse.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Browse.Designer.cs</LastGenOutput>
