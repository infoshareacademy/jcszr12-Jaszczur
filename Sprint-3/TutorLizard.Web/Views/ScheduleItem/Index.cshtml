@model IEnumerable<TutorLizard.BusinessLogic.Models.ScheduleItem>

@{
    ViewData["Title"] = "Schedule Items";
}

<h1>@TutorLizard.Web.Resources.ScheduleItem.ScheduleItems</h1>

<p>
    <a asp-action="Create">@TutorLizard.Web.Resources.ScheduleItem.CreateNew</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @TutorLizard.Web.Resources.ScheduleItem.AdId
            </th>
            <th>
                @TutorLizard.Web.Resources.ScheduleItem.DateTime
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateTime)
            </td>
            <td>
                    @Html.ActionLink(@TutorLizard.Web.Resources.ScheduleItem.Edit, "Edit", new { id = item.Id }) |
                    @Html.ActionLink(@TutorLizard.Web.Resources.ScheduleItem.Details, "Details", new { id = item.Id }) |
                    @Html.ActionLink(@TutorLizard.Web.Resources.ScheduleItem.Delete, "Delete", new { id = item.Id })
            </td>
        </tr>
}
    </tbody>
</table>
