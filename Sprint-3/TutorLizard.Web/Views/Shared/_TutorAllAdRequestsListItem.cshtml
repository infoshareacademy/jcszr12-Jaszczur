@model AdRequestsListDto

<div class="card my-3 ad-list-item">

    <div class="card-body">
        <h5 class="card-title">@Model.AdSubject</h5>
        <div class="row">
            <div class="col-6 col-sm-3">@TutorLizard.Web.Resources.Shared.AdvertTitle :</div>
            <div class="col-6 col-sm-9">@Model.AdTitle</div>
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">@TutorLizard.Web.Resources.Shared.StudentMessage :</div>
            <div class="col-6 col-sm-9">@Model.Message</div>
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">@TutorLizard.Web.Resources.Shared.ReplyMessage :</div>
            <div class="col-6 col-sm-9">@Model.ReplyMessage</div>
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">@TutorLizard.Web.Resources.Shared.ReviewDate :</div>
            @if (Model.ReviewDate is not null)
            {
                <div class="col-6 col-sm-9">@Model.ReviewDate</div>
            }
            else {
                <div class="col-6 col-sm-9">@TutorLizard.Web.Resources.Shared.New !</div>
            }
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">@TutorLizard.Web.Resources.Shared.IsRemote :</div>
                <div class="col-6 col-sm-9">
                    @if (Model.IsRemote)
                {
                    <span class="text-green">@TutorLizard.Web.Resources.Shared.Yes</span>
                }
                else
                {
                    <span class="text-green">@TutorLizard.Web.Resources.Shared.No</span>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-6 col-sm-3">@TutorLizard.Web.Resources.Shared.Status:</div>
            <div class="col-6 col-sm-9">
                @if (Model.IsAccepted)
                {
                    <span class="text-green">@TutorLizard.Web.Resources.Shared.RequestAccepted</span>
                }
                else
                {
                    <span class="text-red">@TutorLizard.Web.Resources.Shared.RequestRejected</span>
                }
            </div>
        </div>
    </div>
</div>
