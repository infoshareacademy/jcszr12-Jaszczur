<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
	<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Localization" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TutorLizard.Shared\TutorLizard.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\AdSearchForm.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AdSearchForm.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Schedule.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Schedule.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\AdSearchForm.en.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\AdSearchForm.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AdSearchForm.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Schedule.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Schedule.Designer.cs</LastGenOutput>
    </EmbeddedResource>
	<EmbeddedResource Update="Resources\Schedule.en.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Schedule.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
